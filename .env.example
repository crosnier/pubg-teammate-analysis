PUBG_API_KEY=your_api_key_here

# Optional: default rate limit (requests/minute) for /players and /seasons
# calls, used until the API's response headers take over. Defaults to 10.
PUBG_RATE_LIMIT_PER_MINUTE=10

# Optional: how many telemetry files fetch concurrently. Defaults to 3.
TELEMETRY_CONCURRENCY=3

# Optional: cap on new telemetry files fetched per run. Defaults to 25.
TELEMETRY_MAX_NEW_PER_RUN=25

# Optional: data budget for Archetype Tag signals (tempo/range/weapon) -
# how many of a player's own recent cached matches to analyze. Starts at
# a 30-day window, widens by 30 days at a time (up to 90 days) until the
# match target is found in-window, then caps at that same number either
# way. Set to 50 for now pending performance follow-up; intended
# production default is 250 once redundant per-signal file-parsing and
# match_scope's full-cache scan cost are addressed.
ARCHETYPE_MAX_MATCHES=50
ARCHETYPE_MIN_MATCHES_TARGET=50
ARCHETYPE_INITIAL_WINDOW_DAYS=30
ARCHETYPE_WINDOW_INCREMENT_DAYS=30
ARCHETYPE_MAX_WINDOW_DAYS=90
